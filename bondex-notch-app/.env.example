# Build-time URL opened by every Purchase action in the distributed Mac app.
BONDEX_CHECKOUT_URL=https://bondex-notch.bondeth.site/checkout/

# Optional Xcode override used by scripts/build-app.sh when xcode-select points
# somewhere else. This value is machine-specific and should not be committed in
# a real .env file.
DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
