<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Applied only with a Developer ID identity, which turns on the hardened
	     runtime. Under it, sending Apple Events (now playing from Music,
	     Spotify and browsers) and reading the calendar each need to be
	     declared, or they fail without a prompt. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
