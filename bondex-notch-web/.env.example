# Public website configuration. Next.js embeds NEXT_PUBLIC values in the build.
NEXT_PUBLIC_SITE_URL=http://localhost:4173
NEXT_PUBLIC_SUPPORT_EMAIL=rithybondeth999@gmail.com

# Stripe server credentials. Never expose these with a NEXT_PUBLIC_ prefix or
# commit real values to Git.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# One-time USD 14.99 Price created for the Bondex Notch lifetime licence.
STRIPE_PRICE_ID=price_replace_me

# Enable only after Stripe Tax and the product tax code are configured.
STRIPE_AUTOMATIC_TAX=false

# CI, NODE_ENV, VERCEL, VERCEL_ENV, and VERCEL_URL are supplied by their
# respective platforms and should not be copied into local or production env.
